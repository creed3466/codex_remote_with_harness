# codex_rc configuration — copy to .env and fill in.
# Run `codex-rc` for an interactive setup that creates this file for you.

# Discord bot — required.
# Get the token at https://discord.com/developers/applications → Bot → Reset Token.
CODEX_RC_DISCORD_TOKEN=
CODEX_RC_DISCORD_APP_ID=
# Optional: guild ID for instant slash-command registration during testing.
CODEX_RC_DISCORD_GUILD_ID=
# Optional channel allowlist (comma-separated). Empty = listen everywhere visible.
CODEX_RC_DISCORD_CHANNEL_IDS=

# Discord user allowlist. Two shapes supported:
#   CSV (single-tenant):
#     CODEX_RC_ALLOWED_USER_IDS=111111111111111111,222222222222222222
#   JSON (per-channel RBAC; "*" is the wildcard):
#     CODEX_RC_ALLOWED_USER_IDS={"*": ["111111111111111111"], "333333333333333333": ["222222222222222222"]}
# Empty value admits everyone (only sane for local dev).
CODEX_RC_ALLOWED_USER_IDS=

# Default sandbox policy for spawned codex sessions.
# Values: workspace-write (default) | read-only | danger-full-access
CODEX_RC_DEFAULT_SANDBOX=workspace-write

# Default approval mode.
# Values: on-request (default) | never | untrusted
CODEX_RC_DEFAULT_APPROVAL=on-request

# Codex transport.
# Values: ws (default, allows `codex --remote` to join the same backend in tmux)
#         stdio (single-process; no remote pane)
CODEX_RC_TRANSPORT=ws

# Channel ↔ session ↔ thread state store (JSON, human-readable).
# This is runtime state, not a log.
# Legacy CODEX_RC_DB_PATH is still honoured as a fallback if present.
CODEX_RC_MEMORY_PATH=./data/state/memory.json

# Operational logs. Only serious redacted errors are written here by default.
CODEX_RC_LOG_ROOT=./data/logs
# Development-only trace root. Full RPC events are written here only when
# CODEX_RC_EVENT_LOG_MODE=debug.
CODEX_RC_DEBUG_ROOT=./data/debug

# Event file policy. Values:
#   errors = redacted serious failures only (default / production)
#   debug  = full RPC trace under data/debug/rpc/<channel>/<date>/
#   off    = no codex_rc event files
CODEX_RC_EVENT_LOG_MODE=errors
# Operational error log retention in days. 0 disables pruning.
CODEX_RC_ERROR_LOG_RETENTION_DAYS=30
# Number of Codex thread metadata records kept in memory.json. 0 disables pruning.
CODEX_RC_THREAD_HISTORY_MAX=100

# Python logger console level (DEBUG | INFO | WARNING | ERROR).
CODEX_RC_LOG_LEVEL=WARNING
# Optional rotating development debug log at DEBUG (5MB×3). Empty disables.
# Example: ./data/debug/codex_rc.log  or  /tmp/codex_rc.log
CODEX_RC_LOG_PATH=

# Log format. Values: text (default, human-readable) | json (one JSON
# object per line for shippers like Vector / Loki / CloudWatch).
CODEX_RC_LOG_FORMAT=text

# v0.2 operational toggles ---------------------------------------------------

# When set, ERROR / EXCEPTION log records from the codex_rc namespace are
# forwarded as embeds to this Discord channel. Leave empty to disable.
CODEX_RC_OPS_CHANNEL_ID=

# When set to a Discord user ID, turn/completed payloads are prefixed with
# `<@uid>` so Discord delivers a push notification to that user.
CODEX_RC_MENTION_ON_COMPLETE=

# When truthy, approval prompts are auto-resolved with the success button
# (no Discord prompt is posted). DANGEROUS — only for trusted, supervised
# unattended runs.
CODEX_RC_AUTO_APPROVE=false

# When > 0, cumulative input tokens crossing this threshold triggers
# thread/compact/start automatically. 0 = disabled.
CODEX_RC_AUTO_COMPACT_INPUT_TOKENS=0

# /healthz HTTP endpoint for external uptime probes.
# Port 0 (or unset) disables the listener entirely.
CODEX_RC_HEALTH_HOST=127.0.0.1
CODEX_RC_HEALTH_PORT=0

# Operator Soul — ego, stance, and voice. Injected on every fresh codex thread.
# Lookup order:
#   1) CODEX_RC_SOUL_PATH if set (this var)
#   2) ./data/config/soul.md    (user-editable, gitignored)
#   3) ./data/soul.md           (legacy fallback)
#   4) bundled src/codex_rc/assets/soul.example.md  (fallback default)
# Leave blank and delete user soul files to use the bundled default.
CODEX_RC_SOUL_PATH=

# Operator Rules — hard constraints. Rules override Soul.
# Lookup order:
#   1) CODEX_RC_RULES_PATH and/or CODEX_RC_RULES_DIR if set
#   2) ./data/config/rules.md + ./data/config/rules.d/*.md
#   3) ./data/soul.d/*.md     (legacy fallback)
#   4) bundled src/codex_rc/assets/rules.d/*.md
CODEX_RC_RULES_PATH=
CODEX_RC_RULES_DIR=
